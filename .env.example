# ELEVARIQ Personal Agent - example configuration (PLACEHOLDERS ONLY).
# Copy to .env (git-ignored). Real environment variables override this file.
# Never commit real credentials. See docs/AUTHENTICATION.md.

# development | test | production
ENVIRONMENT=development

# Root for all persistent state. Defaults: ./data (Linux/macOS), %LOCALAPPDATA%\ElevariqAgent (Windows).
# On a Linux service use a persistent path such as /var/lib/elevariq-agent.
# AGENT_HOME=

# Overrides (default to paths under AGENT_HOME)
# DATABASE_PATH=
# WORKSPACE_ROOT=
# LOG_DIR=
LOG_LEVEL=info
LOG_RETENTION_DAYS=14
LOG_MAX_FILE_MB=20
LOG_TO_CONSOLE=true

# Execution provider: "mock" (default, no network, no cost) or "claude" (Claude Agent SDK, API key auth)
EXECUTION_PROVIDER=mock
# MOCK_SCENARIO_FILE=examples/mock-scenario.json
# CLAUDE_MODEL=
# CLAUDE_CLI_PATH=

# --- Claude provider credentials (unattended runtime) ---
# Supported: Anthropic Console API key. Put the real key ONLY in your untracked .env or the service environment.
# ANTHROPIC_API_KEY=<your-console-api-key>
# The claude provider refuses to run unless paid API use is explicitly authorised AND capped:
ALLOW_PAID_API=false
# Hard cap per execution (USD, passed to the SDK as maxBudgetUsd). Required > 0 when ALLOW_PAID_API=true.
MAX_BUDGET_USD_PER_EXECUTION=0
# Rolling 24h client-side estimated spend limit across all executions (0 = no daily limit)
DAILY_BUDGET_USD=0

# --- Concurrency & retry ---
MAX_CONCURRENT_WORKERS=1
DEFAULT_MAX_RETRIES=3
MAX_CONTINUATIONS=25
MAX_TURNS_PER_EXECUTION=40
# Escalate (BLOCK for owner review) instead of retrying forever:
MAX_INTERRUPTIONS=3
MAX_PROVIDER_FAILURE_STREAK=20
# Delete info/debug activity events older than this
EVENT_RETENTION_DAYS=30
# Timeout for owner-configured build/test verification commands
VERIFY_COMMAND_TIMEOUT_MS=600000

# --- Phase 2 planning ---
# required: the owner must approve a generated plan (npm run agent -- approve <id>) before coding tasks exist. auto: skip approval.
PLAN_APPROVAL=required
MAX_PLAN_TASKS=60
# How often an invalid planning reply is sent back to the model with the validator's errors
MAX_PLAN_REPAIRS=2
BACKOFF_BASE_MS=30000
BACKOFF_MAX_MS=3600000
BACKOFF_JITTER=0.2
# Minimum wait for quota exhaustion when the provider gives no reset time
QUOTA_MIN_WAIT_MS=900000
# Safety margin added after a provider-supplied reset time
RESET_MARGIN_MS=5000

# --- Timing ---
WORKER_TIMEOUT_MS=1800000
HEARTBEAT_INTERVAL_MS=10000
LEASE_TTL_MS=60000
POLL_INTERVAL_MS=2000
SHUTDOWN_GRACE_MS=20000

# Local-only health endpoint (binds 127.0.0.1). 0 disables it.
HEALTH_PORT=0

# --- ELEVARIQ integration placeholders (Phase 1: mocks only; no live calls) ---
INTEGRATION_ERP_ENABLED=false
INTEGRATION_CRM_ENABLED=false
# ELEVARIQ_ERP_BASE_URL=https://erp.example.invalid
# ELEVARIQ_ERP_API_TOKEN=<placeholder>
# ELEVARIQ_CRM_BASE_URL=https://crm.example.invalid
# ELEVARIQ_CRM_API_TOKEN=<placeholder>

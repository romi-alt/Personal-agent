# better-sqlite3 ships prebuilt binaries (linux/darwin/win32, x64/arm64) and loads them at runtime. Without this,
# `npm ci` (lockfile-driven) runs `node-gyp rebuild` for it anyway, which needs a C++ toolchain / Visual Studio and
# FAILS on Windows machines without a node-gyp-compatible Visual Studio (observed on the GitHub windows-latest runner).
# Skipping dependency install scripts also removes a class of supply-chain risk. All project scripts (`npm test`,
# `npm run build`, ...) still run because they are invoked explicitly.
ignore-scripts=true

--- /dev/null
+++ b/src/security/broker/capability.ts
@@ -0,0 +1,149 @@
+/**
+ * Task capability model (V2.1 trusted-execution). A capability grant is the full set of authority a single task's
+ * worker has. It is DEFAULT-DENY: anything not listed is refused. It is task-scoped and non-inheritable: each task
+ * gets a fresh grant derived from its assignment, never from another task.
+ *
+ * SCOPE: application-level. The broker consults a grant before authorizing an action; the OS worker identity (admin
+ * scripts) is what stops a worker from reaching beyond the grant by running its own code.
+ */
+
+export type FileOp = 'read' | 'write' | 'delete';
+
+export interface NetworkCapability {
+  /** Outbound hosts the worker's documented tools may reach. Empty => no network. */
+  allowedHosts: string[];
+  /** Loopback (127.0.0.1/::1) allowed. Default false. */
+  loopback: boolean;
+}
+
+export interface ResourceLimits {
+  maxProcesses: number;
+  maxMemoryMb: number;
+  maxWallSeconds: number;
+}
+
+export interface Capability {
+  /** The one project this grant authorizes. */
+  projectId: string;
+  taskId: string;
+  /** Logical worker identity (OS SID once separation exists). */
+  workerId: string;
+  /** Directories the worker may touch, with the operations allowed in each (default-deny outside these). */
+  directories: { path: string; ops: FileOp[] }[];
+  /** Executable base names the worker may launch (lower-case, no extension). Empty => none beyond the provider. */
+  executables: string[];
+  network: NetworkCapability;
+  limits: ResourceLimits;
+  /** Integration systems (e.g. 'erp') the task may read. */
+  integrations: string[];
+  /** Approval categories pre-authorized for this task (still require a bound, single-use approval to execute). */
+  approvalCategories: string[];
+  /** Absolute expiry (epoch ms). After this, the grant authorizes nothing. */
+  expiresAt: number;
+  /** Policy version the grant was derived under. */
+  policyVersion: string;
+}
+
+export interface CapabilityDecision {
+  allow: boolean;
+  reason: string;
+}
+
+const DENY = (reason: string): CapabilityDecision => ({ allow: false, reason });
+const ALLOW = (reason: string): CapabilityDecision => ({ allow: true, reason });
+
+/** Lexical containment without touching the filesystem (the OS ACL is the real check; this is the model's view). */
+function isInside(child: string, parent: string): boolean {
+  const norm = (p: string) => p.replace(/\\/g, '/').replace(/\/+$/, '').toLowerCase();
+  const c = norm(child);
+  const p = norm(parent);
+  return c === p || c.startsWith(`${p}/`);
+}
+
+/**
+ * Is a file operation within this grant? `resolvedPath` must already be the real, canonical path (symlinks/junctions
+ * resolved) so a link cannot smuggle access past the lexical check.
+ */
+export function canAccessPath(
+  cap: Capability,
+  resolvedPath: string,
+  op: FileOp,
+  now: number,
+): CapabilityDecision {
+  if (now >= cap.expiresAt) return DENY('capability grant has expired');
+  for (const d of cap.directories)
+    if (isInside(resolvedPath, d.path))
+      return d.ops.includes(op)
+        ? ALLOW(`${op} permitted in ${d.path}`)
+        : DENY(`${op} not permitted in ${d.path} (allowed: ${d.ops.join(',') || 'none'})`);
+  return DENY(`path is outside every permitted directory`);
+}
+
+export function canRunExecutable(cap: Capability, exe: string, now: number): CapabilityDecision {
+  if (now >= cap.expiresAt) return DENY('capability grant has expired');
+  const base = (exe.split(/[\\/]/).pop() ?? exe).toLowerCase().replace(/\.(exe|cmd|bat|com|ps1)$/, '');
+  return cap.executables.includes(base)
+    ? ALLOW(`executable ${base} permitted`)
+    : DENY(`executable ${base} not in the task's allow-list`);
+}
+
+export function canReachHost(cap: Capability, host: string, now: number): CapabilityDecision {
+  if (now >= cap.expiresAt) return DENY('capability grant has expired');
+  const h = host.toLowerCase();
+  if (h === '127.0.0.1' || h === '::1' || h === 'localhost')
+    return cap.network.loopback ? ALLOW('loopback permitted') : DENY('loopback not permitted');
+  return cap.network.allowedHosts.map((x) => x.toLowerCase()).includes(h)
+    ? ALLOW(`host ${h} permitted`)
+    : DENY(`host ${h} not in the task's allow-list`);
+}
+
+export function requiresApproval(cap: Capability, category: string): CapabilityDecision {
+  return cap.approvalCategories.includes(category)
+    ? ALLOW(`category ${category} is pre-authorized for this task (bound approval still required)`)
+    : DENY(`category ${category} is not permitted for this task`);
+}
+
+/**
+ * Build a fresh grant for a task. Non-inheritable by construction: the inputs are the task's own project, workspace
+ * and assignment; nothing from another task is read. Conservative defaults: one workspace dir, no network beyond
+ * loopback-off, one process class, short expiry.
+ */
+export function deriveCapability(input: {
+  projectId: string;
+  taskId: string;
+  workerId: string;
+  workspaceDir: string;
+  tempDir: string;
+  readOnlyRefs?: string[];
+  executables?: string[];
+  allowedHosts?: string[];
+  loopback?: boolean;
+  integrations?: string[];
+  approvalCategories?: string[];
+  policyVersion: string;
+  now: number;
+  ttlMs?: number;
+  limits?: Partial<ResourceLimits>;
+}): Capability {
+  return {
+    projectId: input.projectId,
+    taskId: input.taskId,
+    workerId: input.workerId,
+    directories: [
+      { path: input.workspaceDir, ops: ['read', 'write', 'delete'] },
+      { path: input.tempDir, ops: ['read', 'write', 'delete'] },
+      ...(input.readOnlyRefs ?? []).map((p) => ({ path: p, ops: ['read'] as FileOp[] })),
+    ],
+    executables: input.executables ?? [],
+    network: { allowedHosts: input.allowedHosts ?? [], loopback: input.loopback ?? false },
+    limits: {
+      maxProcesses: input.limits?.maxProcesses ?? 32,
+      maxMemoryMb: input.limits?.maxMemoryMb ?? 2048,
+      maxWallSeconds: input.limits?.maxWallSeconds ?? 1800,
+    },
+    integrations: input.integrations ?? [],
+    approvalCategories: input.approvalCategories ?? [],
+    expiresAt: input.now + (input.ttlMs ?? 60 * 60 * 1000),
+    policyVersion: input.policyVersion,
+  };
+}
diff --git a/src/security/broker/ipc.ts b/src/security/broker/ipc.ts
new file mode 100644
index 0000000..0d0648a
--- /dev/null
+++ b/src/security/broker/ipc.ts
@@ -0,0 +1,93 @@
+/**
+ * Trusted IPC interface to the broker (V2.1 trusted-execution).
+ *
+ * The worker never calls the broker in-process; it sends a typed, size-bounded, authenticated request over a
+ * transport. This module is transport-agnostic: the server validates and dispatches; a Windows named-pipe transport
+ * (design in docs) plugs in underneath. Kept transport-agnostic so the validation logic is unit-testable without
+ * admin rights or a real pipe.
+ *
+ * CRITICAL CAVEAT (documented, not worked around): a named pipe whose ACL admits the worker's SID does NOT separate
+ * two processes that run under the SAME SID. Caller-SID verification is only meaningful once the worker runs under a
+ * DISTINCT Windows account. Until then, treat the "authenticated caller" as advisory. See docs TRUSTED IPC section.
+ */
+import { ApprovalBroker, type BrokerOutcome, type BrokerRequest } from './broker.js';
+
+export const MAX_REQUEST_BYTES = 64 * 1024;
+
+export type IpcResponse = { ok: true; outcome: BrokerOutcome } | { ok: false; error: string };
+
+export interface IpcServerDeps {
+  broker: ApprovalBroker;
+  /** Verify the OS identity of the caller against the claimed workerId. Returns null if acceptable, else a reason. */
+  verifyCaller: (claimedWorkerId: string, callerSid: string | null) => string | null;
+  now: () => number;
+  /** Reject requests older/newer than this skew (ms) to bound replay windows. */
+  maxClockSkewMs?: number;
+}
+
+/** Minimal runtime validation of an untrusted request object. Returns a reason string on failure, else null. */
+export function validateRequestShape(value: unknown): string | null {
+  if (typeof value !== 'object' || value === null) return 'request is not an object';
+  const r = value as Record<string, unknown>;
+  const str = (k: string) => typeof r[k] === 'string' && (r[k] as string).length > 0;
+  for (const k of [
+    'workerId',
+    'taskId',
+    'executionId',
+    'projectId',
+    'tool',
+    'cwd',
+    'policyVersion',
+    'requestId',
+  ])
+    if (!str(k)) return `missing or invalid field: ${k}`;
+  if (typeof r['toolInput'] !== 'object' || r['toolInput'] === null) return 'missing toolInput';
+  if (typeof r['at'] !== 'number') return 'missing at';
+  if (r['category'] !== null && typeof r['category'] !== 'string') return 'invalid category';
+  if (r['target'] !== null && typeof r['target'] !== 'string') return 'invalid target';
+  if (r['approval'] !== undefined) {
+    const a = r['approval'];
+    if (typeof a !== 'object' || a === null) return 'invalid approval';
+    const ap = a as Record<string, unknown>;
+    if (typeof ap['grantId'] !== 'string' || typeof ap['nonce'] !== 'string')
+      return 'invalid approval fields';
+  }
+  return null;
+}
+
+export class BrokerIpcServer {
+  constructor(private readonly d: IpcServerDeps) {}
+
+  /**
+   * Handle one raw request frame. `callerSid` is the OS-verified SID of the connecting process (null when the
+   * transport cannot provide it, e.g. in-process tests). Fails closed on every validation error.
+   */
+  handle(rawBytes: Buffer | string, callerSid: string | null): IpcResponse {
+    const text = typeof rawBytes === 'string' ? rawBytes : rawBytes.toString('utf8');
+    if (Buffer.byteLength(text, 'utf8') > MAX_REQUEST_BYTES) return { ok: false, error: 'request too large' };
+
+    let parsed: unknown;
+    try {
+      parsed = JSON.parse(text);
+    } catch {
+      return { ok: false, error: 'malformed JSON' };
+    }
+    const shapeError = validateRequestShape(parsed);
+    if (shapeError) return { ok: false, error: shapeError };
+    const req = parsed as BrokerRequest;
+
+    const skew = this.d.maxClockSkewMs ?? 60_000;
+    if (Math.abs(this.d.now() - req.at) > skew)
+      return { ok: false, error: 'request timestamp outside allowed skew' };
+
+    const callerError = this.d.verifyCaller(req.workerId, callerSid);
+    if (callerError) return { ok: false, error: `caller identity rejected: ${callerError}` };
+
+    try {
+      return { ok: true, outcome: this.d.broker.authorize(req) };
+    } catch (err) {
+      // Fail closed: an internal error is a denial, never an allow.
+      return { ok: false, error: `broker error (fail-closed): ${(err as Error).message}` };
+    }
+  }
+}
diff --git a/tests/unit/broker-approval.test.ts b/tests/unit/broker-approval.test.ts
new file mode 100644
index 0000000..a4c63dc
--- /dev/null
+++ b/tests/unit/broker-approval.test.ts
@@ -0,0 +1,376 @@
+/**
+ * V2.1 trusted-execution: synthetic tests for the application-level approval broker, capability model, single-use
+ * action-bound approvals, hash-chained signed audit, and the IPC validation layer. Nothing here is an OS boundary;
+ * these verify the application logic. No real credential, pipe, account or system object is used.
+ */
+import { describe, expect, it } from 'vitest';
+import { randomBytes } from 'node:crypto';
+import {
+  actionFingerprint,
+  canonicalArgsFor,
+  canonicalJson,
+  type BoundAction,
+} from '../../src/security/broker/canonical.js';
+import {
+  deriveCapability,
+  canAccessPath,
+  canRunExecutable,
+  canReachHost,
+} from '../../src/security/broker/capability.js';
+import { ApprovalGrantStore, DEFAULT_GRANT_TTL_MS } from '../../src/security/broker/approval-grant.js';
+import { AuditChain, MemoryAuditSink, verifyChain } from '../../src/security/broker/audit-chain.js';
+import { ApprovalBroker, type BrokerRequest } from '../../src/security/broker/broker.js';
+import { BrokerIpcServer, validateRequestShape, MAX_REQUEST_BYTES } from '../../src/security/broker/ipc.js';
+
+const identity = (c: string) => c.replace(/\s+/g, ' ').trim();
+
+function fakeNow() {
+  const clock = { t: 1_800_000_000_000 };
+  return { now: () => clock.t, advance: (ms: number) => (clock.t += ms), clock };
+}
+let counter = 0;
+const newId = () => `grant_${(++counter).toString(36)}`;
+
+const baseAction = (over: Partial<BoundAction> = {}): BoundAction => ({
+  category: 'protected_branch_push',
+  tool: 'Bash',
+  canonicalArgs: { command: 'git push origin main' },
+  target: 'origin/main',
+  workerId: 'worker-1',
+  taskId: 'task-1',
+  projectId: 'proj-1',
+  executionId: 'exec-1',
+  cwd: 'C:/ws/proj',
+  policyVersion: 'v1',
+  ...over,
+});
+
+describe('canonical binding', () => {
+  it('canonicalizes object key order so equal actions hash equally', () => {
+    expect(canonicalJson({ b: 1, a: 2 })).toBe(canonicalJson({ a: 2, b: 1 }));
+    expect(actionFingerprint(baseAction())).toBe(actionFingerprint(baseAction()));
+  });
+  it('any meaningful change diverges the fingerprint', () => {
+    const base = actionFingerprint(baseAction());
+    expect(
+      actionFingerprint(baseAction({ canonicalArgs: { command: 'git push --force origin main' } })),
+    ).not.toBe(base);
+    expect(actionFingerprint(baseAction({ target: 'origin/other' }))).not.toBe(base);
+    expect(actionFingerprint(baseAction({ workerId: 'worker-2' }))).not.toBe(base);
+    expect(actionFingerprint(baseAction({ taskId: 'task-2' }))).not.toBe(base);
+    expect(actionFingerprint(baseAction({ cwd: 'C:/ws/other' }))).not.toBe(base);
+    expect(actionFingerprint(baseAction({ policyVersion: 'v2' }))).not.toBe(base);
+  });
+  it('canonicalArgsFor normalizes commands so cosmetic differences do not force re-approval', () => {
+    const a = canonicalArgsFor('Bash', { command: 'git   push   origin main' }, identity);
+    const b = canonicalArgsFor('Bash', { command: 'git push origin main' }, identity);
+    expect(a).toEqual(b);
+  });
+});
+
+describe('capability model (default-deny, task-scoped)', () => {
+  const nowH = fakeNow();
+  const cap = deriveCapability({
+    projectId: 'proj-1',
+    taskId: 'task-1',
+    workerId: 'worker-1',
+    workspaceDir: 'C:/ws/proj',
+    tempDir: 'C:/tmp/task-1',
+    readOnlyRefs: ['C:/ref/lib'],
+    executables: ['node', 'git'],
+    allowedHosts: ['registry.npmjs.org'],
+    integrations: ['erp'],
+    approvalCategories: ['protected_branch_push'],
+    policyVersion: 'v1',
+    now: nowH.now(),
+  });
+  it('permits writes in the workspace and temp, read-only in refs, denies elsewhere', () => {
+    expect(canAccessPath(cap, 'C:/ws/proj/src/a.ts', 'write', nowH.now()).allow).toBe(true);
+    expect(canAccessPath(cap, 'C:/tmp/task-1/x', 'delete', nowH.now()).allow).toBe(true);
+    expect(canAccessPath(cap, 'C:/ref/lib/readme.md', 'read', nowH.now()).allow).toBe(true);
+    expect(canAccessPath(cap, 'C:/ref/lib/readme.md', 'write', nowH.now()).allow).toBe(false);
+    expect(canAccessPath(cap, 'C:/Users/Roman/.ssh/id_rsa', 'read', nowH.now()).allow).toBe(false);
+  });
+  it('allows only listed executables and hosts; loopback off by default', () => {
+    expect(canRunExecutable(cap, 'C:/Program Files/nodejs/node.exe', nowH.now()).allow).toBe(true);
+    expect(canRunExecutable(cap, 'powershell.exe', nowH.now()).allow).toBe(false);
+    expect(canReachHost(cap, 'registry.npmjs.org', nowH.now()).allow).toBe(true);
+    expect(canReachHost(cap, 'evil.example', nowH.now()).allow).toBe(false);
+    expect(canReachHost(cap, '127.0.0.1', nowH.now()).allow).toBe(false);
+  });
+  it('denies everything after expiry', () => {
+    const h = fakeNow();
+    const c = deriveCapability({
+      projectId: 'p',
+      taskId: 't',
+      workerId: 'w',
+      workspaceDir: 'C:/ws',
+      tempDir: 'C:/tmp',
+      policyVersion: 'v1',
+      now: h.now(),
+      ttlMs: 1000,
+    });
+    h.advance(2000);
+    expect(canAccessPath(c, 'C:/ws/a', 'read', h.now()).allow).toBe(false);
+  });
+});
+
+describe('single-use, action-bound approval grants', () => {
+  it('a grant approves exactly one action and cannot be replayed', () => {
+    const h = fakeNow();
+    const store = new ApprovalGrantStore(h.now, newId);
+    const action = baseAction();
+    const g = store.request(action);
+    expect(g.state).toBe('PENDING');
+    // cannot consume before approval
+    expect(store.consume(g.id, g.nonce, action).ok).toBe(false);
+    store.decide(g.id, 'APPROVED', 'owner');
+    // first consume ok
+    expect(store.consume(g.id, g.nonce, action).ok).toBe(true);
+    // replay denied
+    const replay = store.consume(g.id, g.nonce, action);
+    expect(replay.ok).toBe(false);
+    expect(replay.reason).toMatch(/already used/);
+  });
+  it('a changed action does not match the approval', () => {
+    const h = fakeNow();
+    const store = new ApprovalGrantStore(h.now, newId);
+    const g = store.request(baseAction());
+    store.decide(g.id, 'APPROVED', 'owner');
+    const tampered = baseAction({ canonicalArgs: { command: 'git push --force origin main' } });
+    expect(store.consume(g.id, g.nonce, tampered).ok).toBe(false);
+  });
+  it('a wrong nonce is rejected even for the right action', () => {
+    const h = fakeNow();
+    const store = new ApprovalGrantStore(h.now, newId);
+    const g = store.request(baseAction());
+    store.decide(g.id, 'APPROVED', 'owner');
+    expect(store.consume(g.id, randomBytes(32).toString('hex'), baseAction()).ok).toBe(false);
+  });
+  it('expires after its TTL and cannot be consumed', () => {
+    const h = fakeNow();
+    const store = new ApprovalGrantStore(h.now, newId);
+    const g = store.request(baseAction());
+    store.decide(g.id, 'APPROVED', 'owner');
+    h.advance(DEFAULT_GRANT_TTL_MS + 1);
+    const r = store.consume(g.id, g.nonce, baseAction());
+    expect(r.ok).toBe(false);
+    expect(r.reason).toMatch(/expired/);
+  });
+  it('revocation and supersession invalidate a grant', () => {
+    const h = fakeNow();
+    const store = new ApprovalGrantStore(h.now, newId);
+    const g1 = store.request(baseAction());
+    store.decide(g1.id, 'APPROVED', 'owner');
+    store.revoke(g1.id, 'owner', 'changed my mind');
+    expect(store.consume(g1.id, g1.nonce, baseAction()).ok).toBe(false);
+    // re-requesting the same action supersedes any prior live grant
+    const g2 = store.request(baseAction());
+    const g3 = store.request(baseAction());
+    expect(store.get(g2.id)?.state).toBe('REVOKED');
+    expect(store.get(g3.id)?.state).toBe('PENDING');
+  });
+});
+
+describe('hash-chained signed audit', () => {
+  it('appends a verifiable chain and detects edits, deletion and reordering', () => {
+    const h = fakeNow();
+    const key = randomBytes(32);
+    const sink = new MemoryAuditSink();
+    const chain = new AuditChain(sink, key, h.now);
+    chain.append('a', { x: 1 });
+    chain.append('b', { y: 2 });
+    chain.append('c', { z: 3 });
+    expect(verifyChain(sink, key).ok).toBe(true);
+    expect(verifyChain(sink, key).count).toBe(3);
+
+    // edit event 1's data
+    const lines = sink.readAll();
+    const edited = new MemoryAuditSink();
+    const e1 = JSON.parse(lines[1]!);
+    e1.data = { y: 999 };
+    for (const [i, l] of lines.entries()) edited.append(i === 1 ? JSON.stringify(e1) : l);
+    const r = verifyChain(edited, key);
+    expect(r.ok).toBe(false);
+    expect(r.error).toMatch(/altered/);
+
+    // delete the middle event
+    const deleted = new MemoryAuditSink();
+    lines.filter((_, i) => i !== 1).forEach((l) => deleted.append(l));
+    expect(verifyChain(deleted, key).ok).toBe(false);
+
+    // reorder
+    const reordered = new MemoryAuditSink();
+    [lines[0]!, lines[2]!, lines[1]!].forEach((l) => reordered.append(l));
+    expect(verifyChain(reordered, key).ok).toBe(false);
+  });
+  it('a forged tail fails without the signing key, and the real key verifies', () => {
+    const h = fakeNow();
+    const key = randomBytes(32);
+    const sink = new MemoryAuditSink();
+    const chain = new AuditChain(sink, key, h.now);
+    chain.append('a', {});
+    // attacker without the key appends a plausible but wrongly-signed event
+    const forged = new MemoryAuditSink();
+    sink.readAll().forEach((l) => forged.append(l));
+    const last = JSON.parse(sink.readAll()[0]!);
+    forged.append(
+      JSON.stringify({
+        seq: 1,
+        at: h.now(),
+        type: 'forged',
+        data: {},
+        prevHash: last.entryHash,
+        entryHash: 'deadbeef',
+        signature: 'deadbeef',
+      }),
+    );
+    expect(verifyChain(forged, key).ok).toBe(false);
+    // verifying under a DIFFERENT key fails too (signatures are key-bound)
+    expect(verifyChain(sink, randomBytes(32)).ok).toBe(false);
+  });
+  it('a signed checkpoint reflects the head', () => {
+    const h = fakeNow();
+    const key = randomBytes(32);
+    const sink = new MemoryAuditSink();
+    const chain = new AuditChain(sink, key, h.now);
+    chain.append('a', {});
+    chain.append('b', {});
+    const cp = chain.checkpoint();
+    expect(cp.seq).toBe(1);
+    expect(cp.headHash).toHaveLength(64);
+  });
+});
